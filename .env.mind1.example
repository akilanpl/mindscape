# Server-side environment only; never commit the actual credential.
MIND1_PROVIDER_URL=https://api.groq.com/openai/v1
MIND1_MODEL=openai/gpt-oss-120b
MIND1_REASONING_EFFORT=high
MIND1_API_KEY=
MIND1_CONTEXT_CHARS=48000
MIND1_OUTPUT_TOKENS=4096
MIND1_PROVIDER_TIMEOUT=30
MIND1_RETRIEVAL=0
# MIND1_WASI_RUNTIME=/absolute/path/to/fresh/trusted/wasi-runtime
