# Native Mind 1 requires no third-party inference credentials.
# Optional locally reviewed checkpoint; never an external model.
# MIND1_NATIVE_CHECKPOINT=/absolute/path/checkpoint.json
# MIND1_NATIVE_CHECKPOINT_SHA256=<reviewed sha256>
# MIND1_WASI_RUNTIME=/absolute/path/to/trusted/wasi-runtime
MIND1_RETRIEVAL=0
